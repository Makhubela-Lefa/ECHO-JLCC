@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ECHO Admin</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />
</head>

<body class="echo-admin-body">

    <div class="echo-admin-shell">

        <aside class="echo-admin-sidebar">

            <div class="echo-admin-brand">
                <img src="~/images/logo/logo.png"
                     alt="ECHO logo" />

                <span>Admin Portal</span>
            </div>

            <nav class="echo-admin-nav">

                <a asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index">
                    Dashboard
                </a>

                <a asp-area="Admin"
                   asp-controller="Announcements"
                   asp-action="Index">
                    Announcements
                </a>

                <a asp-area="Admin"
                   asp-controller="JoinApplications"
                   asp-action="Index">
                    Join Applications
                </a>

                <a asp-area="Admin"
                   asp-controller="Auditions"
                   asp-action="Index">
                    Auditions
                </a>

                <a asp-area="Admin"
                   asp-controller="ContactEnquiries"
                   asp-action="Index">
                    Contact Enquiries
                </a>

                <a asp-area="Admin"
                   asp-controller="SupportEnquiries"
                   asp-action="Index">
                    Support
                </a>

                <a asp-area="Admin"
                   asp-controller="Productions"
                   asp-action="Index">
                    Productions
                </a>

                <a asp-area="Admin"
                   asp-controller="Team"
                   asp-action="Index">
                    Team
                </a>

                <a asp-area="Admin"
                   asp-controller="Settings"
                   asp-action="Index">
                    Settings
                </a>

            </nav>

            <div class="echo-admin-sidebar-footer">

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    View Public Website
                </a>

                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      method="post">

                    <button type="submit">
                        Sign Out
                    </button>

                </form>

            </div>

        </aside>

        <main class="echo-admin-main">

            <header class="echo-admin-topbar">

                <div>
                    <span class="echo-admin-eyebrow">
                        ECHO Administration
                    </span>

                    <h1>@ViewData["Title"]</h1>
                </div>

                <div class="echo-admin-user">
                    @User.Identity?.Name
                </div>

            </header>

            <section class="echo-admin-content">
                @RenderBody()
            </section>

        </main>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>