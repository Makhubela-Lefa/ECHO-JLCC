@{
    ViewData["Title"] = "About ECHO";
}

<section class="about-hero">
    <div class="about-hero-glow about-hero-glow-left"></div>
    <div class="about-hero-glow about-hero-glow-right"></div>

    <div class="container about-hero-container">
        <div class="about-hero-content">

            <span class="echo-eyebrow">
                About the Ministry
            </span>

            <h1>
                His Voice.
                <span>Transform a Generation.</span>
            </h1>

            <p>
                ECHO is a Christ-centred creative arts ministry established
                to bring the Word of God to life through drama, music, dance,
                storytelling and visual expression.
            </p>

            <div class="about-hero-actions">
                <a href="#meaning"
                   class="btn echo-btn echo-btn-gold">
                    Discover ECHO
                </a>

                <a href="#foundation"
                   class="btn echo-btn echo-btn-outline">
                    Biblical Foundation
                </a>
            </div>

        </div>
    </div>
</section>

<section class="about-meaning-section" id="meaning">
    <div class="container">
        <div class="about-split-layout">

            <div class="about-copy">
                <span class="echo-eyebrow">
                    Why the Name ECHO?
                </span>

                <h2>
                    We exist to echo
                    <span>the voice of God.</span>
                </h2>

                <p>
                    ECHO represents the call to receive the Word of God,
                    carry it faithfully and communicate it creatively to
                    others.
                </p>

                <p>
                    We do not exist to amplify ourselves. We exist to make
                    Christ known, to proclaim His truth and to create spaces
                    where a generation can encounter God through the arts.
                </p>
            </div>

            <div class="about-meaning-card">
                <span class="about-meaning-letter">E</span>

                <div>
                    <h3>Echo His Voice</h3>

                    <p>
                        Every production, song, movement and creative expression
                        should point people back to the Word and character of God.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="about-mission-vision-section">
    <div class="container">

        <div class="about-mission-vision-grid">

            <article class="about-large-card">
                <span class="echo-eyebrow">Our Mission</span>

                <h2>
                    To glorify God through
                    creative excellence.
                </h2>

                <p>
                    ECHO exists to produce Christ-centred creative works,
                    develop God-given gifts, equip young people and advance
                    the Gospel through drama, worship, music, dance,
                    storytelling and visual expression.
                </p>
            </article>

            <article class="about-large-card about-large-card-gold">
                <span class="echo-eyebrow">Our Vision</span>

                <h2>
                    To transform lives through
                    biblical storytelling.
                </h2>

                <p>
                    We envision a growing ministry that unites branches,
                    disciples creative people and becomes a recognised
                    platform for excellent, Christ-centred productions
                    that impact generations.
                </p>
            </article>

        </div>

    </div>
</section>

<section class="about-foundation-section" id="foundation">
    <div class="container">

        <div class="echo-section-heading">
            <span class="echo-eyebrow">
                Biblical Foundation
            </span>

            <h2>
                Built on Scripture.
                <span>Centred on Christ.</span>
            </h2>

            <p>
                ECHO is not built on creativity alone. Every part of the
                ministry is grounded in biblical truth, worship, stewardship,
                discipleship and the Great Commission.
            </p>
        </div>

        <div class="about-scripture-grid">

            <article class="about-scripture-card">
                <span>Romans 10:14</span>

                <h3>Proclaiming the Message</h3>

                <p>
                    We use creative expression as a platform through which
                    people can hear and encounter the Gospel.
                </p>
            </article>

            <article class="about-scripture-card">
                <span>Exodus 31:1–11</span>

                <h3>Creative Gifts from God</h3>

                <p>
                    Scripture shows that God empowers artists, craftsmen and
                    builders with wisdom, skill and creativity for His purposes.
                </p>
            </article>

            <article class="about-scripture-card">
                <span>Psalm 150</span>

                <h3>Worship Through Expression</h3>

                <p>
                    Music, movement and artistic expression can become
                    offerings of praise and worship before God.
                </p>
            </article>

            <article class="about-scripture-card">
                <span>Matthew 28:19–20</span>

                <h3>The Great Commission</h3>

                <p>
                    ECHO seeks to make disciples by communicating Scripture
                    in a way that is accessible, memorable and transformative.
                </p>
            </article>

            <article class="about-scripture-card">
                <span>Colossians 3:23</span>

                <h3>Excellence in Service</h3>

                <p>
                    We pursue excellence because everything we do is ultimately
                    offered to God rather than performed merely for people.
                </p>
            </article>

        </div>

    </div>
</section>

<section class="about-values-section">
    <div class="container">

        <div class="echo-section-heading">
            <span class="echo-eyebrow">
                Our Core Values
            </span>

            <h2>
                The principles that shape
                <span>everything we build.</span>
            </h2>
        </div>

        <div class="about-values-grid">

            <article class="about-value-card">
                <span>01</span>
                <h3>Christ-Centred</h3>
                <p>
                    Jesus Christ remains at the centre of every production,
                    decision and expression.
                </p>
            </article>

            <article class="about-value-card">
                <span>02</span>
                <h3>Excellence</h3>
                <p>
                    We give our best because our gifts and service are offered
                    to God.
                </p>
            </article>

            <article class="about-value-card">
                <span>03</span>
                <h3>Unity</h3>
                <p>
                    We bring branches, generations and ministries together
                    under one shared vision.
                </p>
            </article>

            <article class="about-value-card">
                <span>04</span>
                <h3>Stewardship</h3>
                <p>
                    We responsibly manage every gift, opportunity, resource
                    and responsibility entrusted to us.
                </p>
            </article>

            <article class="about-value-card">
                <span>05</span>
                <h3>Discipleship</h3>
                <p>
                    We seek spiritual growth alongside artistic development.
                </p>
            </article>

            <article class="about-value-card">
                <span>06</span>
                <h3>Creativity</h3>
                <p>
                    We celebrate creative expression as a meaningful instrument
                    for ministry and biblical communication.
                </p>
            </article>

        </div>

    </div>
</section>

<section class="about-founders-section">
    <div class="container">

        <div class="echo-section-heading">
            <span class="echo-eyebrow">
                Our Founding Story
            </span>

            <h2>
                One conversation.
                <span>One shared burden.</span>
            </h2>

            <p>
                ECHO began through a shared desire to create more opportunities
                for fellowship, ministry, creative development and biblical
                engagement across the different JLCC branches.
            </p>
        </div>

        <div class="about-founders-grid">

            <article class="about-founder-card">
                <img src="~/images/team/khensani.jpeg"
                     alt="Khensani, Co-Founder of ECHO" />

                <div class="about-founder-content">
                    <span>Co-Founder</span>
                    <h3>Khensani</h3>
                    <blockquote>
                        “Excellence honours God.”
                    </blockquote>
                </div>
            </article>

            <article class="about-founder-card about-founder-featured">
                <img src="~/images/team/lefa.jpeg"
                     alt="Lefa, Co-Founder of ECHO" />

                <div class="about-founder-content">
                    <span>Co-Founder</span>
                    <h3>Lefa</h3>
                    <blockquote>
                        “We are not creating performances.
                        We are creating encounters.”
                    </blockquote>
                </div>
            </article>

            <article class="about-founder-card">
                <img src="~/images/team/praise.jpeg"
                     alt="Praise, Co-Founder of ECHO" />

                <div class="about-founder-content">
                    <span>Co-Founder</span>
                    <h3>Praise</h3>
                    <blockquote>
                        “Everything we build should point people to Christ.”
                    </blockquote>
                </div>
            </article>

        </div>

    </div>
</section>

<section class="about-future-section">
    <div class="container">

        <div class="about-future-panel">

            <span class="echo-eyebrow">
                The Vision Ahead
            </span>

            <h2>
                Starting faithfully.
                <span>Growing intentionally.</span>
            </h2>

            <p>
                ECHO will begin with branch introductions, recruitment,
                auditions, training and its first flagship production,
                <em>When Fire Fell</em>.
            </p>

            <p>
                As the ministry grows, we envision annual productions,
                creative workshops, worship gatherings, outreach initiatives
                and opportunities to take biblical theatre beyond the walls
                of the local church.
            </p>

            <div class="about-future-actions">
                <a asp-controller="Productions"
                   asp-action="WhenFireFell"
                   class="btn echo-btn echo-btn-gold">
                    Explore When Fire Fell
                </a>

                <a asp-controller="Home"
                   asp-action="Join"
                   class="btn echo-btn echo-btn-gold">
                    Join ECHO
                </a>
            </div>

        </div>

    </div>
</section>