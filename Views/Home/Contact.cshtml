@{
    ViewData["Title"] = "Contact ECHO";
}

<section class="contact-hero">
    <div class="contact-hero-glow contact-hero-glow-left"></div>
    <div class="contact-hero-glow contact-hero-glow-right"></div>

    <div class="container contact-hero-container">
        <div class="contact-hero-content">

            <span class="echo-eyebrow">
                Connect with ECHO
            </span>

            <h1>
                Let us begin
                <span>the conversation.</span>
            </h1>

            <p>
                Contact ECHO regarding membership, auditions, partnerships,
                productions, church-branch visits, media enquiries or general
                information.
            </p>

            <div class="contact-hero-actions">
                <a href="#contact-form"
                   class="btn echo-btn echo-btn-gold">
                    Send an Enquiry
                </a>

                <a href="#contact-options"
                   class="btn echo-btn echo-btn-outline">
                    Contact Options
                </a>
            </div>

        </div>
    </div>
</section>

<section class="contact-introduction-section">
    <div class="container">

        <div class="contact-introduction-grid">

            <div>
                <span class="echo-eyebrow">
                    We Would Love to Hear from You
                </span>

                <h2>
                    Questions, ideas and partnerships
                    <span>are welcome.</span>
                </h2>
            </div>

            <div>
                <p>
                    Whether you would like to join a department, audition,
                    support a production, invite ECHO to visit a branch or
                    discuss a partnership, the appropriate team member will
                    respond to your enquiry.
                </p>

                <p>
                    To protect the privacy of the co-founders and ministry
                    team, personal contact details are not publicly displayed.
                    All communication should go through the official ECHO
                    channels.
                </p>
            </div>

        </div>

    </div>
</section>

<section class="contact-options-section" id="contact-options">
    <div class="container">

        <div class="echo-section-heading">
            <span class="echo-eyebrow">
                Contact Options
            </span>

            <h2>
                Choose the channel
                <span>that suits your enquiry.</span>
            </h2>

            <p>
                Official contact details will be activated once the ministry’s
                communication channels have been finalised.
            </p>
        </div>

        <div class="contact-options-grid">

            <article class="contact-option-card">
                <span class="contact-option-number">01</span>

                <h3>Email ECHO</h3>

                <p>
                    Suitable for formal enquiries, documents, partnership
                    proposals and detailed communication.
                </p>

                <div class="contact-option-detail">
                    Official email coming soon
                </div>
            </article>

            <article class="contact-option-card">
                <span class="contact-option-number">02</span>

                <h3>WhatsApp ECHO</h3>

                <p>
                    Suitable for membership questions, audition updates,
                    branch communication and general assistance.
                </p>

                <div class="contact-option-detail">
                    Official WhatsApp number coming soon
                </div>
            </article>

            <article class="contact-option-card">
                <span class="contact-option-number">03</span>

                <h3>Social Media</h3>

                <p>
                    Follow ECHO for announcements, production updates,
                    audition information and ministry content.
                </p>

                <div class="contact-option-detail">
                    Social-media pages coming soon
                </div>
            </article>

        </div>

    </div>
</section>

<section class="contact-enquiry-types-section">
    <div class="container">

        <div class="contact-enquiry-panel">

            <div class="contact-enquiry-copy">
                <span class="echo-eyebrow">
                    How Can We Help?
                </span>

                <h2>
                    Direct your message
                    <span>to the right team.</span>
                </h2>

                <p>
                    Selecting the correct enquiry type helps us send your
                    message to the department best equipped to respond.
                </p>
            </div>

            <div class="contact-enquiry-list">

                <div>
                    <span>01</span>
                    <p>Joining ECHO or selecting a department</p>
                </div>

                <div>
                    <span>02</span>
                    <p>Audition or casting information</p>
                </div>

                <div>
                    <span>03</span>
                    <p>Partnership, sponsorship or support</p>
                </div>

                <div>
                    <span>04</span>
                    <p>Church-branch visits and presentations</p>
                </div>

                <div>
                    <span>05</span>
                    <p>Media, communications and interviews</p>
                </div>

                <div>
                    <span>06</span>
                    <p>General information or feedback</p>
                </div>

            </div>

        </div>

    </div>
</section>

<section class="contact-form-section" id="contact-form">
    <div class="container">

        <div class="contact-form-layout">

            <div class="contact-form-information">
                <span class="echo-eyebrow">
                    Send a Message
                </span>

                <h2>
                    Tell us how we can
                    <span>assist you.</span>
                </h2>

                <p>
                    Complete the form with as much detail as possible. Once
                    the contact-management system is activated, your enquiry
                    will be saved and assigned to the relevant team member.
                </p>

                <div class="contact-response-note">
                    <span>Response Time</span>

                    <p>
                        ECHO is currently run by volunteers. Responses may not
                        be immediate, but every genuine enquiry will be reviewed.
                    </p>
                </div>
            </div>

            <div class="contact-form-card">

                <form>
                    <div class="contact-form-grid">

                        <div class="contact-form-group">
                            <label for="contactFirstName">
                                First name
                            </label>

                            <input id="contactFirstName"
                                   name="contactFirstName"
                                   type="text"
                                   placeholder="Enter your first name" />
                        </div>

                        <div class="contact-form-group">
                            <label for="contactLastName">
                                Surname
                            </label>

                            <input id="contactLastName"
                                   name="contactLastName"
                                   type="text"
                                   placeholder="Enter your surname" />
                        </div>

                        <div class="contact-form-group">
                            <label for="contactEmail">
                                Email address
                            </label>

                            <input id="contactEmail"
                                   name="contactEmail"
                                   type="email"
                                   placeholder="Enter your email address" />
                        </div>

                        <div class="contact-form-group">
                            <label for="contactPhone">
                                WhatsApp number
                            </label>

                            <input id="contactPhone"
                                   name="contactPhone"
                                   type="tel"
                                   placeholder="e.g. 071 234 5678" />
                        </div>

                        <div class="contact-form-group contact-form-group-full">
                            <label for="contactBranch">
                                JLCC branch or organisation
                            </label>

                            <input id="contactBranch"
                                   name="contactBranch"
                                   type="text"
                                   placeholder="Optional" />
                        </div>

                        <div class="contact-form-group contact-form-group-full">
                            <label for="contactEnquiryType">
                                Enquiry type
                            </label>

                            <select id="contactEnquiryType"
                                    name="contactEnquiryType">

                                <option value="">
                                    Select an enquiry type
                                </option>

                                <option>Joining ECHO</option>
                                <option>Auditions and Casting</option>
                                <option>Productions</option>
                                <option>Partnerships and Support</option>
                                <option>Branch Visit or Presentation</option>
                                <option>Media and Communications</option>
                                <option>General Enquiry</option>
                                <option>Feedback</option>
                            </select>
                        </div>

                        <div class="contact-form-group contact-form-group-full">
                            <label for="contactSubject">
                                Subject
                            </label>

                            <input id="contactSubject"
                                   name="contactSubject"
                                   type="text"
                                   placeholder="Briefly describe your enquiry" />
                        </div>

                        <div class="contact-form-group contact-form-group-full">
                            <label for="contactMessage">
                                Message
                            </label>

                            <textarea id="contactMessage"
                                      name="contactMessage"
                                      rows="7"
                                      placeholder="Write your message here."></textarea>
                        </div>

                        <div class="contact-consent contact-form-group-full">
                            <input id="contactConsent"
                                   name="contactConsent"
                                   type="checkbox" />

                            <label for="contactConsent">
                                I consent to ECHO using the information supplied
                                to respond to this enquiry and communicate
                                relevant next steps.
                            </label>
                        </div>

                        <div class="contact-form-group-full">
                            <button type="button"
                                    class="btn echo-btn echo-btn-gold contact-submit-button">
                                Send Message
                            </button>

                            <p class="contact-form-status">
                                Online messages will become available once the
                                contact-management system is activated.
                            </p>
                        </div>

                    </div>
                </form>

            </div>

        </div>

    </div>
</section>

<section class="contact-safety-section">
    <div class="container">

        <div class="contact-safety-panel">

            <span class="echo-eyebrow">
                Official Communication
            </span>

            <h2>
                Protecting the ECHO community
                <span>from false communication.</span>
            </h2>

            <p>
                Official announcements, banking details, audition instructions
                and partnership requests will only be communicated through
                approved ECHO or JLCC channels.
            </p>

            <p>
                Please verify any suspicious request before sharing personal
                information, documents or money.
            </p>

        </div>

    </div>
</section>