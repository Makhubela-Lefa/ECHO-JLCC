@{
    ViewData["Title"] = "Privacy";
}

<section class="privacy-hero">
    <div class="privacy-hero-glow privacy-hero-glow-left"></div>
    <div class="privacy-hero-glow privacy-hero-glow-right"></div>

    <div class="container privacy-hero-container">
        <div class="privacy-hero-content">

            <span class="echo-eyebrow">
                Privacy and Information
            </span>

            <h1>
                Your information matters.
                <span>We handle it responsibly.</span>
            </h1>

            <p>
                This notice explains how ECHO intends to collect, use,
                protect and manage personal information submitted through
                the website.
            </p>

            <a href="#privacy-content"
               class="btn echo-btn echo-btn-gold">
                Read the Privacy Notice
            </a>

        </div>
    </div>
</section>

<section class="privacy-content-section" id="privacy-content">
    <div class="container">

        <div class="privacy-layout">

            <aside class="privacy-navigation">
                <span class="echo-eyebrow">
                    On This Page
                </span>

                <a href="#information-collected">Information Collected</a>
                <a href="#information-use">How It Is Used</a>
                <a href="#information-sharing">Information Sharing</a>
                <a href="#information-storage">Storage and Security</a>
                <a href="#minors">Information About Minors</a>
                <a href="#rights">Your Rights</a>
                <a href="#contact-privacy">Privacy Enquiries</a>
            </aside>

            <div class="privacy-document">

                <section class="privacy-section">
                    <span class="privacy-section-number">01</span>

                    <h2>Purpose of This Notice</h2>

                    <p>
                        ECHO is committed to treating personal information
                        with care, confidentiality and responsibility.
                    </p>

                    <p>
                        This privacy notice applies to information submitted
                        through the ECHO website, including membership,
                        audition, contact and partnership forms.
                    </p>
                </section>

                <section class="privacy-section"
                         id="information-collected">

                    <span class="privacy-section-number">02</span>

                    <h2>Information We May Collect</h2>

                    <p>
                        Depending on the form completed, ECHO may collect:
                    </p>

                    <ul>
                        <li>First name and surname</li>
                        <li>Email address and WhatsApp number</li>
                        <li>Age</li>
                        <li>JLCC branch or organisation</li>
                        <li>Preferred department or audition category</li>
                        <li>Availability and ministry interests</li>
                        <li>Previous experience</li>
                        <li>Messages, enquiries and feedback</li>
                        <li>Partnership or support information</li>
                    </ul>
                </section>

                <section class="privacy-section"
                         id="information-use">

                    <span class="privacy-section-number">03</span>

                    <h2>How Information May Be Used</h2>

                    <p>
                        Information submitted through the website may be used to:
                    </p>

                    <ul>
                        <li>Respond to enquiries</li>
                        <li>Contact prospective members</li>
                        <li>Arrange auditions and orientation</li>
                        <li>Coordinate departments and production teams</li>
                        <li>Communicate approved ministry updates</li>
                        <li>Review partnership and support enquiries</li>
                        <li>Maintain necessary administrative records</li>
                        <li>Protect the safety and integrity of ECHO activities</li>
                    </ul>
                </section>

                <section class="privacy-section"
                         id="information-sharing">

                    <span class="privacy-section-number">04</span>

                    <h2>Who May Access the Information</h2>

                    <p>
                        Personal information will only be accessible to
                        authorised ECHO team members and relevant JLCC
                        leadership where access is necessary for ministry,
                        administration, safety or oversight.
                    </p>

                    <p>
                        ECHO will not sell personal information or share it
                        with unrelated third parties for marketing purposes.
                    </p>
                </section>

                <section class="privacy-section"
                         id="information-storage">

                    <span class="privacy-section-number">05</span>

                    <h2>Storage and Security</h2>

                    <p>
                        Reasonable technical and organisational measures will
                        be used to protect personal information from
                        unauthorised access, loss, alteration or misuse.
                    </p>

                    <p>
                        Access to the private administration area will be
                        restricted to authorised users through secure login
                        credentials and role-based permissions.
                    </p>

                    <p>
                        No online system can guarantee absolute security.
                        ECHO will therefore continue to review its processes
                        as the website develops.
                    </p>
                </section>

                <section class="privacy-section"
                         id="minors">

                    <span class="privacy-section-number">06</span>

                    <h2>Information About Minors</h2>

                    <p>
                        Some ECHO participants may be under the age of 18.
                        Where appropriate, parental or guardian consent may
                        be required before participation, auditions,
                        photography, travel or production activities.
                    </p>

                    <p>
                        Additional consent and safeguarding processes may be
                        introduced as the ministry’s systems are finalised.
                    </p>
                </section>

                <section class="privacy-section"
                         id="rights">

                    <span class="privacy-section-number">07</span>

                    <h2>Your Rights and Choices</h2>

                    <p>
                        A person may contact ECHO to:
                    </p>

                    <ul>
                        <li>Ask what information is held about them</li>
                        <li>Request correction of inaccurate information</li>
                        <li>Withdraw consent where applicable</li>
                        <li>Request deletion where retention is no longer necessary</li>
                        <li>Ask how their information has been used</li>
                    </ul>

                    <p>
                        Some information may need to be retained where there
                        is a legitimate administrative, legal, safety or
                        ministry reason.
                    </p>
                </section>

                <section class="privacy-section">
                    <span class="privacy-section-number">08</span>

                    <h2>Cookies and Technical Information</h2>

                    <p>
                        The website may use essential technical cookies for
                        authentication, security and normal website operation.
                    </p>

                    <p>
                        If analytics or additional tracking tools are added
                        later, this notice will be updated accordingly.
                    </p>
                </section>

                <section class="privacy-section"
                         id="contact-privacy">

                    <span class="privacy-section-number">09</span>

                    <h2>Privacy Enquiries</h2>

                    <p>
                        Questions, concerns or requests relating to personal
                        information may be submitted through the official
                        Contact ECHO page.
                    </p>

                    <a asp-controller="Home"
                       asp-action="Contact"
                       class="btn echo-btn echo-btn-outline">
                        Contact ECHO
                    </a>
                </section>

                <section class="privacy-section privacy-section-final">
                    <span class="privacy-section-number">10</span>

                    <h2>Updates to This Notice</h2>

                    <p>
                        This notice may be updated as ECHO’s website,
                        administrative systems and ministry activities develop.
                    </p>

                    <p>
                        The latest version will always be published on this page.
                    </p>

                    <p class="privacy-updated">
                        Last updated: August 2026
                    </p>
                </section>

            </div>

        </div>

    </div>
</section>