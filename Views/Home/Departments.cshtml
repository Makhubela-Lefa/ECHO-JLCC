@{
    ViewData["Title"] = "Departments";
}

<section class="departments-hero">
    <div class="departments-hero-glow departments-hero-glow-left"></div>
    <div class="departments-hero-glow departments-hero-glow-right"></div>

    <div class="container departments-hero-container">
        <div class="departments-hero-content">

            <span class="echo-eyebrow">
                Find Your Place
            </span>

            <h1>
                One ministry.
                <span>Many ways to serve.</span>
            </h1>

            <p>
                ECHO brings together spiritual formation, creative expression,
                technical excellence, outreach and administration under one
                shared purpose: echoing the voice of God and transforming a
                generation.
            </p>

            <div class="departments-hero-actions">
                <a href="#department-list"
                   class="btn echo-btn echo-btn-gold">
                    Explore Departments
                </a>

                <a asp-controller="Home"
                   asp-action="Join"
                   class="department-link">
                    Join This Department →
                </a>
            </div>

        </div>
    </div>
</section>

<section class="departments-introduction">
    <div class="container">
        <div class="departments-introduction-grid">

            <div>
                <span class="echo-eyebrow">
                    Built for Every Gift
                </span>

                <h2>
                    You do not need to stand on stage
                    <span>to be part of the story.</span>
                </h2>
            </div>

            <div>
                <p>
                    A production requires far more than actors and singers.
                    It requires prayer, discipleship, organisation, design,
                    communication, evangelism, partnerships and people who
                    faithfully serve behind the scenes.
                </p>

                <p>
                    The eight departments of ECHO allow people to contribute
                    according to their gifts, experience, interests and calling.
                </p>
            </div>

        </div>
    </div>
</section>

<section class="departments-list-section" id="department-list">
    <div class="container">

        <div class="echo-section-heading">
            <span class="echo-eyebrow">
                The Structure of ECHO
            </span>

            <h2>
                Eight departments.
                <span>One shared mission.</span>
            </h2>

            <p>
                Every department carries a distinct responsibility while
                working closely with the others to fulfil the wider vision
                of ECHO.
            </p>
        </div>

        <div class="departments-grid">

            <article class="department-card">
                <div class="department-card-top">
                    <span class="department-number">01</span>
                    <span class="department-category">Spiritual Formation</span>
                </div>

                <h3>Spiritual Life and Discipleship</h3>

                <p class="department-purpose">
                    Protecting the spiritual foundation of ECHO and ensuring
                    that every creative activity remains rooted in prayer,
                    Scripture and Christ-centred discipleship.
                </p>

                <div class="department-responsibilities">
                    <h4>Areas of Service</h4>

                    <ul>
                        <li>Prayer and intercession</li>
                        <li>Devotions and Bible studies</li>
                        <li>Spiritual preparation of cast and crew</li>
                        <li>Pastoral care and encouragement</li>
                        <li>Discipleship throughout rehearsals</li>
                    </ul>
                </div>

                <p class="department-suited">
                    Suited to intercessors, Bible-study leaders, mentors and
                    people passionate about spiritual growth.
                </p>

                <a asp-controller="Home"
                   asp-action="Join"
                   class="department-link">
                    Join This Department →
                </a>
            </article>

            <article class="department-card">
                <div class="department-card-top">
                    <span class="department-number">02</span>
                    <span class="department-category">Story Development</span>
                </div>

                <h3>Creative Productions</h3>

                <p class="department-purpose">
                    Developing the biblical stories, scripts and creative
                    direction that shape every ECHO production.
                </p>

                <div class="department-responsibilities">
                    <h4>Areas of Service</h4>

                    <ul>
                        <li>Biblical and historical research</li>
                        <li>Scriptwriting and editing</li>
                        <li>Narration and spoken word development</li>
                        <li>Production concepts and scene planning</li>
                        <li>Creative direction</li>
                    </ul>
                </div>

                <p class="department-suited">
                    Suited to writers, researchers, storytellers, directors
                    and people who enjoy developing ideas.
                </p>

                <a asp-controller="Home"
                   asp-action="Join"
                   class="department-link">
                    Join This Department →
                </a>
            </article>

            <article class="department-card">
                <div class="department-card-top">
                    <span class="department-number">03</span>
                    <span class="department-category">Stage Ministry</span>
                </div>

                <h3>Performing Arts</h3>

                <p class="department-purpose">
                    Communicating Scripture through acting, music, worship,
                    dance, movement, narration and other live expressions.
                </p>

                <div class="department-responsibilities">
                    <h4>Areas of Service</h4>

                    <ul>
                        <li>Acting and character performance</li>
                        <li>Choir and vocal ministry</li>
                        <li>Dance and movement</li>
                        <li>Spoken word and narration</li>
                        <li>Performance training and rehearsals</li>
                    </ul>
                </div>

                <p class="department-suited">
                    Suited to actors, singers, dancers, narrators, musicians
                    and confident or developing performers.
                </p>

                <a asp-controller="Home"
                   asp-action="Join"
                   class="department-link">
                    Join This Department →
                </a>
            </article>

            <article class="department-card">
                <div class="department-card-top">
                    <span class="department-number">04</span>
                    <span class="department-category">Digital Storytelling</span>
                </div>

                <h3>Media, Communications and Digital Ministry</h3>

                <p class="department-purpose">
                    Communicating the ECHO vision clearly and creatively
                    across digital platforms, church branches and public
                    audiences.
                </p>

                <div class="department-responsibilities">
                    <h4>Areas of Service</h4>

                    <ul>
                        <li>Photography and videography</li>
                        <li>Social media and content creation</li>
                        <li>Graphic design and branding</li>
                        <li>Website and digital-platform management</li>
                        <li>Announcements and public communication</li>
                    </ul>
                </div>

                <p class="department-suited">
                    Suited to photographers, videographers, designers,
                    developers, writers and social-media creatives.
                </p>

                <a asp-controller="Home"
                   asp-action="Join"
                   class="department-link">
                    Join This Department →
                </a>
            </article>

            <article class="department-card">
                <div class="department-card-top">
                    <span class="department-number">05</span>
                    <span class="department-category">Production Design</span>
                </div>

                <h3>Technical Arts and Design</h3>

                <p class="department-purpose">
                    Building the visual and technical environment that allows
                    each production to feel immersive, professional and safe.
                </p>

                <div class="department-responsibilities">
                    <h4>Areas of Service</h4>

                    <ul>
                        <li>Lighting and sound</li>
                        <li>Stage and set design</li>
                        <li>Props and scenic elements</li>
                        <li>Costumes, hair and makeup</li>
                        <li>Technical cues and backstage support</li>
                    </ul>
                </div>

                <p class="department-suited">
                    Suited to technicians, designers, decorators, builders,
                    makeup artists and practical problem-solvers.
                </p>

                <a href="#join-department"
                   class="department-link">
                    Join This Department →
                </a>
            </article>

            <article class="department-card">
                <div class="department-card-top">
                    <span class="department-number">06</span>
                    <span class="department-category">Gospel Impact</span>
                </div>

                <h3>Outreach and Evangelism</h3>

                <p class="department-purpose">
                    Ensuring that ECHO reaches beyond its internal activities
                    and uses every opportunity to share Christ, welcome people
                    and serve communities.
                </p>

                <div class="department-responsibilities">
                    <h4>Areas of Service</h4>

                    <ul>
                        <li>Branch introduction visits</li>
                        <li>Community and church outreach</li>
                        <li>Audience engagement</li>
                        <li>Evangelism and ministry response</li>
                        <li>Welcoming and follow-up</li>
                    </ul>
                </div>

                <p class="department-suited">
                    Suited to evangelists, welcoming personalities, community
                    workers and people passionate about reaching others.
                </p>

                <a href="#join-department"
                   class="department-link">
                    Join This Department →
                </a>
            </article>

            <article class="department-card">
                <div class="department-card-top">
                    <span class="department-number">07</span>
                    <span class="department-category">Coordination</span>
                </div>

                <h3>Administration and Operations</h3>

                <p class="department-purpose">
                    Coordinating the people, schedules, communication and
                    logistics required to keep ECHO organised and accountable.
                </p>

                <div class="department-responsibilities">
                    <h4>Areas of Service</h4>

                    <ul>
                        <li>Scheduling and record keeping</li>
                        <li>Branch and team coordination</li>
                        <li>Audition and rehearsal administration</li>
                        <li>Transport and venue logistics</li>
                        <li>Hospitality and event operations</li>
                    </ul>
                </div>

                <p class="department-suited">
                    Suited to organised planners, coordinators, administrators
                    and people who enjoy keeping systems on track.
                </p>

                <a href="#join-department"
                   class="department-link">
                    Join This Department →
                </a>
            </article>

            <article class="department-card">
                <div class="department-card-top">
                    <span class="department-number">08</span>
                    <span class="department-category">Sustainability</span>
                </div>

                <h3>Partnerships and Resource Development</h3>

                <p class="department-purpose">
                    Building the financial, material and relational support
                    required for ECHO to operate responsibly and grow
                    sustainably.
                </p>

                <div class="department-responsibilities">
                    <h4>Areas of Service</h4>

                    <ul>
                        <li>Fundraising initiatives</li>
                        <li>Sponsorship and partnership development</li>
                        <li>Donor communication</li>
                        <li>Resource mobilisation</li>
                        <li>Financial planning and accountability support</li>
                    </ul>
                </div>

                <p class="department-suited">
                    Suited to fundraisers, entrepreneurs, communicators,
                    relationship-builders and strategic thinkers.
                </p>

                <a href="#join-department"
                   class="department-link">
                    Join This Department →
                </a>
            </article>

        </div>
    </div>
</section>

<section class="departments-collaboration-section">
    <div class="container">

        <div class="departments-collaboration-panel">
            <span class="echo-eyebrow">
                Working as One
            </span>

            <h2>
                Different responsibilities.
                <span>One Kingdom purpose.</span>
            </h2>

            <p>
                No department operates in isolation. Creative Productions
                develops the story, Performing Arts brings it to the stage,
                Technical Arts creates the environment, Media communicates it,
                Administration coordinates it and Spiritual Life keeps the
                entire ministry rooted in God.
            </p>

            <p>
                Together, every department contributes toward one complete
                ministry experience.
            </p>
        </div>

    </div>
</section>

<section class="departments-join-section" id="join-department">
    <div class="container">

        <div class="echo-join-panel">
            <span class="echo-eyebrow">
                Discover Where You Belong
            </span>

            <h2>
                Your gift may be exactly what
                ECHO needs next.
            </h2>

            <p>
                You do not need professional experience to express interest.
                We are looking for people who are willing to learn, serve,
                grow spiritually and build with others.
            </p>

            <div class="echo-join-actions">
                <a asp-controller="Home"
                   asp-action="Join"
                   class="btn echo-btn echo-btn-gold">
                    Join a Department
                </a>

                <a href="#"
                   class="btn echo-btn echo-btn-outline">
                    Ask a Question
                </a>
            </div>
        </div>

    </div>
</section>