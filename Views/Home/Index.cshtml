@{
    ViewData["Title"] = "Home";
}

<section class="echo-hero">
    <div class="echo-hero-glow echo-hero-glow-left"></div>
    <div class="echo-hero-glow echo-hero-glow-right"></div>

    <div class="container echo-hero-container">
        <div class="echo-hero-content">

            <span class="echo-eyebrow">
                Jesus is Lord Christian Centre presents
            </span>

            <p class="echo-presented-by">
                The Official Creative Arts Ministry · Established 2026
            </p>

            <img src="~/images/logo/logo.png"
                 alt="ECHO — His Voice, Transform a Generation"
                 class="echo-hero-logo" />

            <p class="echo-hero-tagline">
                His Voice.<br />
                Transform a Generation.
            </p>

            <h1>
                Bringing the Word of God
                <span>to life.</span>
            </h1>

            <p class="echo-hero-description">
                A Christ-centred creative arts ministry using drama,
                music, dance, storytelling and visual expression to
                proclaim the Gospel, develop gifts and transform a
                generation.
            </p>

            <div class="echo-hero-actions">
                <a href="#join"
                   class="btn echo-btn echo-btn-gold">
                    Join the Movement
                </a>

                <a href="#production"
                   class="btn echo-btn echo-btn-outline">
                    Discover ECHO
                </a>
            </div>

            <div class="echo-hero-statements">
                <span>Hear it.</span>
                <span>Live it.</span>
                <span>Share it.</span>
            </div>
        </div>
    </div>
</section>

<section class="echo-introduction" id="about">
    <div class="container">
        <div class="echo-section-heading">
            <span class="echo-eyebrow">What Is ECHO?</span>

            <h2>
                Creative expression.
                <span>Kingdom purpose.</span>
            </h2>

            <p>
                ECHO is a Christ-centred creative arts ministry that brings
                the Word of God to life through drama, music, dance,
                storytelling and visual expression.
            </p>

            <p>
                We exist to proclaim the Gospel, develop God-given gifts,
                unite the JLCC family and create spaces where people can
                encounter God through artistic excellence.
            </p>
        </div>

        <div class="echo-card-grid">
            <article class="echo-floating-card">
                <span class="echo-card-number">01</span>

                <div class="echo-card-icon" aria-hidden="true">
                    🎭
                </div>

                <h3>Drama</h3>

                <p>
                    Bringing Scripture to life through powerful,
                    biblically grounded theatrical storytelling.
                </p>
            </article>

            <article class="echo-floating-card">
                <span class="echo-card-number">02</span>

                <div class="echo-card-icon" aria-hidden="true">
                    ♪
                </div>

                <h3>Music</h3>

                <p>
                    Creating worship moments that prepare hearts,
                    communicate truth and glorify God.
                </p>
            </article>

            <article class="echo-floating-card">
                <span class="echo-card-number">03</span>

                <div class="echo-card-icon" aria-hidden="true">
                    ✦
                </div>

                <h3>Dance</h3>

                <p>
                    Using movement to express worship, emotion,
                    spiritual truth and biblical transformation.
                </p>
            </article>
        </div>
    </div>
</section>

<section class="echo-team-section" id="team">
    <div class="container">
        <div class="echo-section-heading">
            <span class="echo-eyebrow">Meet the Visionaries</span>

            <h2>
                Founded together.
                <span>Building with one vision.</span>
            </h2>

            <p>
                ECHO was established through a shared desire to create a
                Christ-centred ministry that uses creative excellence to
                proclaim God's Word and develop a generation.
            </p>
        </div>

        <div class="echo-team-grid">

            <article class="echo-team-card">
                <div class="echo-team-image-wrapper">
                    <img src="~/images/team/khensani.jpeg"
                         alt="Khensani, Co-Founder of ECHO"
                         class="echo-team-image" />
                </div>

                <div class="echo-team-content">
                    <span class="echo-team-role">Co-Founder</span>

                    <h3>Khensani</h3>

                    <blockquote>
                        “Excellence honours God.”
                    </blockquote>
                </div>
            </article>

            <article class="echo-team-card echo-team-card-featured">
                <div class="echo-team-image-wrapper">
                    <img src="~/images/team/lefa.jpeg"
                         alt="Lefa, Co-Founder of ECHO"
                         class="echo-team-image" />
                </div>

                <div class="echo-team-content">
                    <span class="echo-team-role">Co-Founder</span>

                    <h3>Lefa</h3>

                    <blockquote>
                        “We are not creating performances.
                        We are creating encounters.”
                    </blockquote>
                </div>
            </article>

            <article class="echo-team-card">
                <div class="echo-team-image-wrapper">
                    <img src="~/images/team/praise.jpeg"
                         alt="Praise, Co-Founder of ECHO"
                         class="echo-team-image" />
                </div>

                <div class="echo-team-content">
                    <span class="echo-team-role">Co-Founder</span>

                    <h3>Praise</h3>

                    <blockquote>
                        “Everything we build should point people to Christ.”
                    </blockquote>
                </div>
            </article>

        </div>
    </div>
</section>

<section class="echo-journey-section" id="journey">
    <div class="container">
        <div class="echo-section-heading">
            <span class="echo-eyebrow">The Journey Ahead</span>

            <h2>
                From introduction
                <span>to opening night.</span>
            </h2>

            <p>
                ECHO will grow in carefully planned stages as we introduce
                the ministry, recruit members, develop gifts and prepare
                for our first flagship production.
            </p>
        </div>

        <div class="echo-timeline">

            <article class="echo-timeline-item">
                <span class="echo-timeline-year">2026</span>

                <div class="echo-timeline-content">
                    <h3>Introducing ECHO</h3>

                    <p>
                        Visiting JLCC branches, presenting the vision,
                        registering interested members and building the
                        national creative community.
                    </p>
                </div>
            </article>

            <article class="echo-timeline-item">
                <span class="echo-timeline-year">2026–2027</span>

                <div class="echo-timeline-content">
                    <h3>Auditions and Development</h3>

                    <p>
                        Selecting the cast and creative teams, studying
                        Scripture, training participants and beginning
                        local branch rehearsals.
                    </p>
                </div>
            </article>

            <article class="echo-timeline-item">
                <span class="echo-timeline-year">2027</span>

                <div class="echo-timeline-content">
                    <h3>National Rehearsals</h3>

                    <p>
                        Bringing branches together at key milestones to
                        develop blocking, acting, music, dance and
                        production coordination.
                    </p>
                </div>
            </article>

            <article class="echo-timeline-item">
                <span class="echo-timeline-year">December 2027</span>

                <div class="echo-timeline-content">
                    <h3>When Fire Fell</h3>

                    <p>
                        ECHO presents its first flagship biblical theatre
                        production—the story of the prophet Elijah.
                    </p>
                </div>
            </article>

        </div>
    </div>
</section>

<section class="echo-production-preview" id="production">
    <div class="container">
        <div class="echo-production-card">

            <div class="echo-production-image-wrapper">
                <img src="~/images/productions/elijah/mount-carmel.jpg"
                     alt="Concept artwork for When Fire Fell"
                     class="echo-production-image" />
            </div>

            <div class="echo-production-content">
                <span class="echo-eyebrow">
                    First Flagship Production
                </span>

                <h2>When Fire Fell</h2>

                <p class="echo-production-subtitle">
                    The story of the prophet Elijah
                </p>

                <p>
                    A theatrical journey through national darkness,
                    drought, divine provision, Mount Carmel, the
                    wilderness and the gentle whisper of God.
                </p>

                <a asp-controller="Productions"
                   asp-action="WhenFireFell"
                   class="btn echo-btn echo-btn-outline">
                    Explore the Production
                </a>
            </div>
        </div>
    </div>
</section>

<section class="echo-join-section" id="join">
    <div class="container">
        <div class="echo-join-panel">

            <span class="echo-eyebrow">
                Your Gift Has a Place
            </span>

            <h2>
                Ready to become part of what God is building?
            </h2>

            <p>
                Whether you are an actor, singer, dancer, writer,
                intercessor, photographer, designer, administrator,
                stage crew member or volunteer, there is a place for
                you within ECHO.
            </p>

            <div class="echo-join-actions">
                <a asp-controller="Home"
                   asp-action="Join"
                   class="btn echo-btn echo-btn-gold">
                    Join ECHO
                </a>

                <a asp-controller="Home"
                   asp-action="Auditions"
                   class="btn echo-btn echo-btn-outline">
                    Explore Auditions
                </a>

                <a asp-controller="Home"
                   asp-action="Support"
                   class="btn echo-btn echo-btn-outline">
                    Support ECHO
                </a>
            </div>

        </div>
    </div>
</section>