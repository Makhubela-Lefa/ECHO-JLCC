@{
    ViewData["Title"] = "Support ECHO";
}

<section class="support-hero">
    <div class="support-hero-glow support-hero-glow-left"></div>
    <div class="support-hero-glow support-hero-glow-right"></div>

    <div class="container support-hero-container">
        <div class="support-hero-content">

            <span class="echo-eyebrow">
                Partner with the Vision
            </span>

            <h1>
                Help us build
                <span>what God has entrusted to us.</span>
            </h1>

            <p>
                Every contribution helps ECHO create Christ-centred productions,
                develop gifts, unite branches and communicate the Word of God
                through creative excellence.
            </p>

            <div class="support-hero-actions">
                <a href="#ways-to-support"
                   class="btn echo-btn echo-btn-gold">
                    Ways to Support
                </a>

                <a href="#support-enquiry"
                   class="btn echo-btn echo-btn-outline">
                    Become a Partner
                </a>
            </div>

        </div>
    </div>
</section>

<section class="support-introduction-section">
    <div class="container">

        <div class="support-introduction-grid">

            <div>
                <span class="echo-eyebrow">
                    More Than Financial Giving
                </span>

                <h2>
                    Every resource can become
                    <span>part of the ministry.</span>
                </h2>
            </div>

            <div>
                <p>
                    Some people may support ECHO financially. Others may offer
                    professional skills, equipment, materials, transport,
                    refreshments, printing, venues or practical assistance.
                </p>

                <p>
                    Our goal is to steward every contribution responsibly,
                    transparently and under the oversight of church leadership.
                </p>
            </div>

        </div>

    </div>
</section>

<section class="support-options-section" id="ways-to-support">
    <div class="container">

        <div class="echo-section-heading">
            <span class="echo-eyebrow">
                Ways to Support ECHO
            </span>

            <h2>
                Different contributions.
                <span>One shared impact.</span>
            </h2>

            <p>
                Individuals, families, ministries and businesses may partner
                with ECHO according to their capacity and available resources.
            </p>
        </div>

        <div class="support-options-grid">

            <article class="support-option-card">
                <span class="support-option-number">01</span>

                <h3>Financial Contributions</h3>

                <p>
                    Contribute toward approved production expenses,
                    administration, training and ministry development.
                </p>

                <ul>
                    <li>Once-off contributions</li>
                    <li>Monthly support</li>
                    <li>Production sponsorship</li>
                    <li>Fundraising contributions</li>
                </ul>
            </article>

            <article class="support-option-card">
                <span class="support-option-number">02</span>

                <h3>Costumes and Materials</h3>

                <p>
                    Support the visual development of productions through
                    fabrics, clothing, accessories and construction materials.
                </p>

                <ul>
                    <li>Fabric and sewing materials</li>
                    <li>Costume sponsorship</li>
                    <li>Makeup and hair supplies</li>
                    <li>Reusable clothing and accessories</li>
                </ul>
            </article>

            <article class="support-option-card">
                <span class="support-option-number">03</span>

                <h3>Props and Stage Resources</h3>

                <p>
                    Help create the environments and theatrical moments that
                    allow biblical stories to come alive.
                </p>

                <ul>
                    <li>Wood and building supplies</li>
                    <li>Stage décor and scenic materials</li>
                    <li>Curtains and draping</li>
                    <li>Furniture and reusable props</li>
                </ul>
            </article>

            <article class="support-option-card">
                <span class="support-option-number">04</span>

                <h3>Technical Equipment</h3>

                <p>
                    Support lighting, sound, communication and other technical
                    requirements needed for a professional production.
                </p>

                <ul>
                    <li>Lighting equipment</li>
                    <li>Microphones and sound equipment</li>
                    <li>Smoke or haze machines</li>
                    <li>Cables, stands and technical accessories</li>
                </ul>
            </article>

            <article class="support-option-card">
                <span class="support-option-number">05</span>

                <h3>Transport and Hospitality</h3>

                <p>
                    Assist participants travelling between branches and support
                    the wellbeing of teams during rehearsals and productions.
                </p>

                <ul>
                    <li>Transport sponsorship</li>
                    <li>Fuel contributions</li>
                    <li>Meals and refreshments</li>
                    <li>Accommodation support</li>
                </ul>
            </article>

            <article class="support-option-card">
                <span class="support-option-number">06</span>

                <h3>Professional Services</h3>

                <p>
                    Offer your skills or business services toward the growth
                    and excellence of the ministry.
                </p>

                <ul>
                    <li>Printing and branding</li>
                    <li>Photography and videography</li>
                    <li>Graphic and production design</li>
                    <li>Training, coaching and consultation</li>
                </ul>
            </article>

        </div>

    </div>
</section>

<section class="support-production-section">
    <div class="container">

        <div class="support-production-panel">

            <div class="support-production-copy">
                <span class="echo-eyebrow">
                    Support Our First Production
                </span>

                <h2>
                    Help bring
                    <span>When Fire Fell</span>
                    to life.
                </h2>

                <p>
                    ECHO’s first flagship production will require costumes,
                    props, stage design, technical equipment, transport,
                    rehearsal support, printing and other resources.
                </p>

                <a asp-controller="Productions"
                   asp-action="WhenFireFell"
                   class="department-link">
                    Explore the Production →
                </a>
            </div>

            <div class="support-production-list">

                <div>
                    <span>01</span>
                    <p>Sponsor a costume or character wardrobe.</p>
                </div>

                <div>
                    <span>02</span>
                    <p>Contribute toward lighting and technical equipment.</p>
                </div>

                <div>
                    <span>03</span>
                    <p>Support transport for national rehearsals.</p>
                </div>

                <div>
                    <span>04</span>
                    <p>Provide refreshments for cast and crew.</p>
                </div>

                <div>
                    <span>05</span>
                    <p>Donate or lend reusable props and materials.</p>
                </div>

            </div>

        </div>

    </div>
</section>

<section class="support-accountability-section">
    <div class="container">

        <div class="echo-section-heading">
            <span class="echo-eyebrow">
                Responsible Stewardship
            </span>

            <h2>
                Giving handled with
                <span>care and accountability.</span>
            </h2>
        </div>

        <div class="support-accountability-grid">

            <article>
                <span>01</span>
                <h3>Leadership Oversight</h3>
                <p>
                    ECHO operates under the covering and supervision of
                    JLCC leadership.
                </p>
            </article>

            <article>
                <span>02</span>
                <h3>Clear Records</h3>
                <p>
                    Contributions, fundraising income and approved expenditure
                    will be properly recorded.
                </p>
            </article>

            <article>
                <span>03</span>
                <h3>Approved Purposes</h3>
                <p>
                    Resources will be used only for approved ministry and
                    production requirements.
                </p>
            </article>

            <article>
                <span>04</span>
                <h3>Responsible Communication</h3>
                <p>
                    Partners will receive clear information regarding needs,
                    processes and relevant updates.
                </p>
            </article>

        </div>

    </div>
</section>

<section class="support-details-section">
    <div class="container">

        <div class="support-details-panel">

            <span class="echo-eyebrow">
                Giving Details
            </span>

            <h2>
                Official contribution details
                <span>will be published soon.</span>
            </h2>

            <p>
                ECHO’s approved banking and contribution information will be
                added once the official financial structure has been finalised
                under church leadership.
            </p>

            <div class="support-details-notice">
                Please do not send funds to personal accounts presented as
                belonging to ECHO. Official details will only be communicated
                through approved ECHO and JLCC platforms.
            </div>

        </div>

    </div>
</section>

<section class="support-enquiry-section" id="support-enquiry">
    <div class="container">

        <div class="support-form-layout">

            <div class="support-form-information">
                <span class="echo-eyebrow">
                    Partnership Enquiry
                </span>

                <h2>
                    Tell us how you would
                    <span>like to support ECHO.</span>
                </h2>

                <p>
                    Complete the form to express interest in donating,
                    sponsoring, providing materials or offering a professional
                    service.
                </p>

                <div class="support-form-note">
                    <span>Next Steps</span>

                    <p>
                        An authorised ECHO representative will contact you to
                        discuss the proposed contribution and confirm the
                        appropriate process.
                    </p>
                </div>
            </div>

            <div class="support-form-card">

                <form>
                    <div class="support-form-grid">

                        <div class="support-form-group">
                            <label for="supportName">Full name</label>

                            <input id="supportName"
                                   name="supportName"
                                   type="text"
                                   placeholder="Enter your full name" />
                        </div>

                        <div class="support-form-group">
                            <label for="supportOrganisation">
                                Organisation or business
                            </label>

                            <input id="supportOrganisation"
                                   name="supportOrganisation"
                                   type="text"
                                   placeholder="Optional" />
                        </div>

                        <div class="support-form-group">
                            <label for="supportPhone">
                                WhatsApp number
                            </label>

                            <input id="supportPhone"
                                   name="supportPhone"
                                   type="tel"
                                   placeholder="e.g. 071 234 5678" />
                        </div>

                        <div class="support-form-group">
                            <label for="supportEmail">
                                Email address
                            </label>

                            <input id="supportEmail"
                                   name="supportEmail"
                                   type="email"
                                   placeholder="Enter your email address" />
                        </div>

                        <div class="support-form-group support-form-group-full">
                            <label for="supportType">
                                Type of support
                            </label>

                            <select id="supportType" name="supportType">
                                <option value="">
                                    Select a support category
                                </option>

                                <option>Financial Contribution</option>
                                <option>Costumes and Materials</option>
                                <option>Props and Stage Resources</option>
                                <option>Technical Equipment</option>
                                <option>Transport and Hospitality</option>
                                <option>Professional Service</option>
                                <option>Business Partnership</option>
                                <option>Other</option>
                            </select>
                        </div>

                        <div class="support-form-group support-form-group-full">
                            <label for="supportMessage">
                                Tell us about your proposed support
                            </label>

                            <textarea id="supportMessage"
                                      name="supportMessage"
                                      rows="6"
                                      placeholder="Describe how you or your organisation would like to support ECHO."></textarea>
                        </div>

                        <div class="support-consent support-form-group-full">
                            <input id="supportConsent"
                                   name="supportConsent"
                                   type="checkbox" />

                            <label for="supportConsent">
                                I consent to ECHO using the information supplied
                                to contact me regarding this partnership or
                                contribution enquiry.
                            </label>
                        </div>

                        <div class="support-form-group-full">
                            <button type="button"
                                    class="btn echo-btn echo-btn-gold support-submit-button">
                                Submit Partnership Enquiry
                            </button>

                            <p class="support-form-status">
                                Online submissions will become available once
                                the support-management system is activated.
                            </p>
                        </div>

                    </div>
                </form>

            </div>

        </div>

    </div>
</section>