@{
    ViewData["Title"] = "When Fire Fell";
}

<section class="production-hero">
    <div class="production-hero-overlay"></div>

    <img src="~/images/productions/elijah/mount-carmel.jpg"
         alt="Elijah standing before the altar on Mount Carmel"
         class="production-hero-background" />

    <div class="container production-hero-container">
        <div class="production-hero-content">

            <a asp-controller="Home"
               asp-action="Index"
               class="production-back-link">
                ← Back to ECHO
            </a>

            <span class="echo-eyebrow">
                ECHO's First Flagship Production
            </span>

            <h1>
                When Fire Fell
            </h1>

            <p class="production-hero-subtitle">
                A theatrical production based on the life of the prophet Elijah.
            </p>

            <div class="production-hero-details">
                <span>December 2027</span>
                <span>Biblical Theatre</span>
                <span>JLCC National Production</span>
            </div>

            <div class="production-hero-actions">
                <a href="#story"
                   class="btn echo-btn echo-btn-gold">
                    Discover the Story
                </a>

                <a href="#auditions"
                   class="btn echo-btn echo-btn-outline">
                    Audition Information
                </a>
            </div>

        </div>
    </div>
</section>

<section class="production-introduction" id="story">
    <div class="container">
        <div class="production-introduction-grid">

            <div>
                <span class="echo-eyebrow">The Production Vision</span>

                <h2>
                    A nation in darkness.
                    <span>A prophet who refused to bow.</span>
                </h2>
            </div>

            <div class="production-introduction-copy">
                <p>
                    During one of the darkest spiritual periods in Israel's
                    history, King Ahab and Queen Jezebel led the nation into
                    the worship of Baal.
                </p>

                <p>
                    Into this darkness, God raised Elijah—a prophet who stood
                    almost completely alone and called the nation back to
                    true worship.
                </p>

                <p>
                    <em>When Fire Fell</em> follows Elijah through drought,
                    divine provision, Mount Carmel, exhaustion, restoration
                    and his final journey into glory.
                </p>
            </div>

        </div>
    </div>
</section>

<section class="production-theme-section">
    <div class="container">

        <div class="production-theme-panel">
            <span class="echo-eyebrow">Central Theme</span>

            <blockquote>
                “God never abandons those who stand for Him.”
            </blockquote>

            <p>
                Every scene will remind the audience that God remains faithful
                through drought, opposition, loneliness, victory and restoration.
            </p>
        </div>

    </div>
</section>

<section class="production-journey">
    <div class="container">

        <div class="echo-section-heading">
            <span class="echo-eyebrow">The Story Journey</span>

            <h2>
                From national darkness
                <span>to the revelation of God.</span>
            </h2>

            <p>
                The production unfolds through six connected movements,
                allowing the audience to experience Elijah's complete journey.
            </p>
        </div>

        <div class="production-act-grid">

            <article class="production-act-card">
                <span>Act 01</span>
                <h3>Darkness</h3>
                <p>
                    Israel turns away from God under the leadership of
                    Ahab and Jezebel.
                </p>
            </article>

            <article class="production-act-card">
                <span>Act 02</span>
                <h3>Drought</h3>
                <p>
                    Elijah declares that there will be no rain, and the
                    nation begins to experience physical and spiritual dryness.
                </p>
            </article>

            <article class="production-act-card">
                <span>Act 03</span>
                <h3>Provision</h3>
                <p>
                    God sustains Elijah through ravens and provides for
                    the widow of Zarephath.
                </p>
            </article>

            <article class="production-act-card">
                <span>Act 04</span>
                <h3>Fire</h3>
                <p>
                    Elijah confronts the prophets of Baal, rebuilds the
                    altar and calls the nation back to God.
                </p>
            </article>

            <article class="production-act-card">
                <span>Act 05</span>
                <h3>The Wilderness</h3>
                <p>
                    After victory, Elijah becomes weary, afraid and deeply
                    discouraged.
                </p>
            </article>

            <article class="production-act-card">
                <span>Act 06</span>
                <h3>The Whisper & Glory</h3>
                <p>
                    God restores Elijah through His gentle presence before
                    taking him into heaven.
                </p>
            </article>

        </div>
    </div>
</section>

<section class="production-gallery-section">
    <div class="container">

        <div class="echo-section-heading">
            <span class="echo-eyebrow">Scene Concepts</span>

            <h2>
                Bringing the Word
                <span>to life.</span>
            </h2>

            <p>
                These concept images offer an early glimpse into the atmosphere,
                movement and theatrical direction envisioned for the production.
            </p>
        </div>

        <div class="production-gallery">

            <figure class="production-gallery-card production-gallery-wide">
                <img src="~/images/productions/elijah/drought.jpg"
                     alt="Concept artwork representing the drought in Elijah's story" />

                <figcaption>
                    <span>The Drought</span>
                    <p>
                        A slow spiritual dance expresses a land crying out
                        for rain and a nation suffering from spiritual dryness.
                    </p>
                </figcaption>
            </figure>

            <figure class="production-gallery-card">
                <img src="~/images/productions/elijah/mount-carmel.jpg"
                     alt="Concept artwork representing Mount Carmel" />

                <figcaption>
                    <span>Mount Carmel</span>
                    <p>
                        The altar is rebuilt, Elijah prays and the Lord
                        answers by fire.
                    </p>
                </figcaption>
            </figure>

            <figure class="production-gallery-card">
                <img src="~/images/productions/elijah/wilderness.jpg"
                     alt="Concept artwork representing Elijah in the wilderness" />

                <figcaption>
                    <span>The Wilderness</span>
                    <p>
                        God meets an exhausted prophet with rest, compassion
                        and restoration.
                    </p>
                </figcaption>
            </figure>

        </div>
    </div>
</section>

<section class="production-collage-section">
    <div class="container">
        <div class="production-collage-card">

            <img src="~/images/productions/elijah/all.jpeg"
                 alt="Concept collage showing scenes from the When Fire Fell production"
                 class="production-collage-image" />

            <div class="production-collage-overlay"></div>

            <div class="production-collage-content">
                <span class="echo-eyebrow">
                    The Complete Vision
                </span>

                <h2>
                    One story.
                    <span>Many unforgettable moments.</span>
                </h2>

                <p>
                    From national darkness and drought to Mount Carmel,
                    restoration and glory, each scene will work together
                    to create one complete encounter with the story of Elijah.
                </p>
            </div>

        </div>
    </div>
</section>

<section class="production-lessons-section">
    <div class="container">

        <div class="echo-section-heading">
            <span class="echo-eyebrow">What the Story Teaches</span>

            <h2>
                Truths that remain
                <span>relevant today.</span>
            </h2>
        </div>

        <div class="production-lessons-grid">

            <article>
                <span>01</span>
                <p>
                    God remains faithful even when society turns away from Him.
                </p>
            </article>

            <article>
                <span>02</span>
                <p>
                    One obedient person can influence an entire nation.
                </p>
            </article>

            <article>
                <span>03</span>
                <p>
                    God provides during seasons that appear impossible.
                </p>
            </article>

            <article>
                <span>04</span>
                <p>
                    Spiritual strength does not mean never becoming weary.
                </p>
            </article>

            <article>
                <span>05</span>
                <p>
                    God's presence is revealed through both power and intimacy.
                </p>
            </article>

            <article>
                <span>06</span>
                <p>
                    Faithfulness is more important than popularity.
                </p>
            </article>

        </div>
    </div>
</section>

<section class="echo-join-section" id="auditions">
    <div class="container">

        <div class="echo-join-panel">
            <span class="echo-eyebrow">Become Part of the Production</span>

            <h2>
                There is a place for your gift in
                <em>When Fire Fell.</em>
            </h2>

            <p>
                Actors, singers, dancers, intercessors, writers, stage crew,
                designers, media teams and volunteers will all contribute
                toward bringing this production to life.
            </p>

            <div class="echo-join-actions">
                <a href="#"
                   class="btn echo-btn echo-btn-gold">
                    Register Your Interest
                </a>

                <a href="#"
                   class="btn echo-btn echo-btn-outline">
                    View Audition Information
                </a>
            </div>
        </div>

    </div>
</section>