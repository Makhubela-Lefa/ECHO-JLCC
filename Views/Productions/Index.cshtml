@{
    ViewData["Title"] = "Productions";
}

<section class="productions-page-hero">
    <div class="productions-page-glow productions-page-glow-left"></div>
    <div class="productions-page-glow productions-page-glow-right"></div>

    <div class="container productions-page-hero-container">
        <div class="productions-page-hero-content">

            <span class="echo-eyebrow">
                Biblical Theatre by ECHO
            </span>

            <h1>
                Stories remembered.
                <span>Scripture brought to life.</span>
            </h1>

            <p>
                ECHO creates Christ-centred productions that transform
                biblical accounts into immersive experiences through acting,
                music, movement, narration and visual storytelling.
            </p>

            <div class="productions-page-hero-actions">
                <a href="#current-production"
                   class="btn echo-btn echo-btn-gold">
                    Current Production
                </a>

                <a href="#future-productions"
                   class="btn echo-btn echo-btn-outline">
                    The Journey Ahead
                </a>
            </div>

        </div>
    </div>
</section>

<section class="productions-purpose-section">
    <div class="container">

        <div class="productions-purpose-grid">

            <div>
                <span class="echo-eyebrow">
                    Why We Produce
                </span>

                <h2>
                    Not entertainment alone.
                    <span>Every production carries a message.</span>
                </h2>
            </div>

            <div>
                <p>
                    ECHO productions are created to help audiences encounter
                    Scripture in a way that is memorable, emotionally engaging
                    and faithful to the biblical message.
                </p>

                <p>
                    Each production also becomes a place of discipleship.
                    Cast and crew members study the story, develop their gifts,
                    serve together and grow spiritually throughout the process.
                </p>
            </div>

        </div>

    </div>
</section>

<section class="current-production-section" id="current-production">
    <div class="container">

        <div class="echo-section-heading">
            <span class="echo-eyebrow">
                First Flagship Production
            </span>

            <h2>
                Our first story:
                <span>When Fire Fell.</span>
            </h2>

            <p>
                The story of Elijah becomes the beginning of ECHO’s journey
                into biblical theatre.
            </p>
        </div>

        <article class="current-production-card">

            <div class="current-production-image-wrapper">
                <img src="~/images/productions/elijah/mount-carmel.jpg"
                     alt="Concept artwork for When Fire Fell, ECHO's production about Elijah"
                     class="current-production-image" />
            </div>

            <div class="current-production-content">
                <span class="production-status">
                    In Development
                </span>

                <h3>When Fire Fell</h3>

                <p class="current-production-tagline">
                    The story of the prophet Elijah
                </p>

                <p>
                    A nation has abandoned God. A prophet stands almost alone.
                    Through drought, provision, confrontation, fire, exhaustion
                    and restoration, Elijah’s story reveals the power and
                    faithfulness of God.
                </p>

                <div class="current-production-details">
                    <span>Elijah</span>
                    <span>Biblical Theatre</span>
                    <span>First Flagship Production</span>
                </div>

                <div class="current-production-actions">
                    <a asp-controller="Productions"
                       asp-action="WhenFireFell"
                       class="btn echo-btn echo-btn-gold">
                        Explore When Fire Fell
                    </a>

                    <a asp-controller="Home"
                       asp-action="Auditions"
                       class="btn echo-btn echo-btn-outline">
                        Audition Information
                    </a>
                </div>
            </div>

        </article>

    </div>
</section>

<section class="future-productions-section" id="future-productions">
    <div class="container">

        <div class="echo-section-heading">
            <span class="echo-eyebrow">
                The Next Chapter
            </span>

            <h2>
                One production begins.
                <span>Another story waits.</span>
            </h2>

            <p>
                ECHO is intended to grow into an annual production ministry,
                presenting different biblical accounts through creative arts.
            </p>
        </div>

        <article class="future-production-card">

            <img src="~/images/productions/david/david.jpg"
                 alt="Concept artwork introducing a future ECHO production about David"
                 class="future-production-image" />

            <div class="future-production-overlay"></div>

            <div class="future-production-content">
                <span class="production-status">
                    Future Production
                </span>

                <h3>David</h3>

                <p class="future-production-subtitle">
                    Shepherd. Worshipper. Warrior. King.
                </p>

                <p>
                    After Elijah, ECHO intends to explore the extraordinary
                    journey of David—from the fields of Bethlehem and the
                    confrontation with Goliath to worship, leadership,
                    failure, repentance and kingship.
                </p>

                <p class="future-production-note">
                    The official title, date and full creative concept will
                    be announced after development and leadership approval.
                </p>
            </div>

        </article>

    </div>
</section>

<section class="production-principles-section">
    <div class="container">

        <div class="echo-section-heading">
            <span class="echo-eyebrow">
                Our Production Principles
            </span>

            <h2>
                Creative excellence.
                <span>Biblical responsibility.</span>
            </h2>
        </div>

        <div class="production-principles-grid">

            <article>
                <span>01</span>
                <h3>Scripture First</h3>
                <p>
                    Biblical research and context guide the development
                    of every script and scene.
                </p>
            </article>

            <article>
                <span>02</span>
                <h3>Christ-Centred</h3>
                <p>
                    The purpose is not to glorify performers, but to direct
                    people toward God and His Word.
                </p>
            </article>

            <article>
                <span>03</span>
                <h3>Spiritually Prepared</h3>
                <p>
                    Prayer, discipleship and spiritual formation remain part
                    of the production process.
                </p>
            </article>

            <article>
                <span>04</span>
                <h3>Artistically Excellent</h3>
                <p>
                    Acting, music, design, movement and technical execution
                    are developed with discipline and care.
                </p>
            </article>

        </div>

    </div>
</section>

<section class="productions-cta-section">
    <div class="container">

        <div class="echo-join-panel">
            <span class="echo-eyebrow">
                Become Part of the Story
            </span>

            <h2>
                ECHO productions are built by
                people willing to serve.
            </h2>

            <p>
                Whether your gift belongs on stage, backstage, in prayer,
                in administration or within technical production, there is
                a place for you in what ECHO is building.
            </p>

            <div class="echo-join-actions">
                <a asp-controller="Home"
                   asp-action="Join"
                   class="btn echo-btn echo-btn-gold">
                    Join ECHO
                </a>

                <a asp-controller="Home"
                   asp-action="Departments"
                   class="btn echo-btn echo-btn-outline">
                    Explore Departments
                </a>
            </div>
        </div>

    </div>
</section>