<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] | ECHO</title>

    <meta name="description"
          content="ECHO is a Christ-centred creative arts ministry bringing the Word of God to life." />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Echo.Web.styles.css"
          asp-append-version="true" />
</head>

<body>

    <div class="echo-loader"
         id="echoLoader"
         role="status"
         aria-live="polite"
         aria-label="Loading ECHO">

        <div class="echo-loader-content">
            <img src="~/images/logo/logo.png"
                 alt=""
                 class="echo-loader-logo" />

            <div class="echo-loader-ring"
                 aria-hidden="true">
            </div>

            <span>Loading ECHO</span>
        </div>
    </div>

    <header class="echo-header">
        <nav class="navbar navbar-expand-lg echo-navbar">
            <div class="container echo-navbar-container">

                <a class="navbar-brand echo-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/logo/logo.png"
                         alt="ECHO logo"
                         class="echo-navbar-logo" />
                </a>

                <button class="navbar-toggler echo-navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#echoNavigation"
                        aria-controls="echoNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="echoNavigation">

                    <ul class="navbar-nav mx-auto echo-nav-links">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="About">
                                About
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Departments">
                                Departments
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Productions"
                               asp-action="Index">
                                Productions
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Auditions">
                                Auditions
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Contact">
                                Contact
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Announcements">
                                Announcements
                            </a>
                        </li>
                    </ul>

                    <div class="echo-navbar-actions">
                        <partial name="_LoginPartial" />

                        <a asp-controller="Home"
                           asp-action="Join"
                           class="btn echo-btn echo-btn-gold">

                            Join ECHO

                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="echo-footer" id="contact">
        <div class="container">
            <div class="echo-footer-grid">

                <div class="echo-footer-brand">
                    <img src="~/images/logo/logo.png"
                         alt="ECHO logo"
                         class="echo-footer-logo" />

                    <p>
                        Bringing the Word of God to life through
                        drama, music, dance, storytelling and
                        creative excellence.
                    </p>
                </div>

                <div class="echo-footer-column">
                    <h3>Explore</h3>

                    <a asp-controller="Home"
                       asp-action="Index">
                        Home
                    </a>

                    <a asp-controller="Home"
                       asp-action="About">
                        About ECHO
                    </a>

                    <a asp-controller="Home"
                       asp-action="Departments">
                        Departments
                    </a>

                    <a asp-controller="Productions"
                       asp-action="Index">
                        Productions
                    </a>

                    <a asp-controller="Home"
                       asp-action="Contact">
                        Contact
                    </a>

                    <a asp-controller="Home"
                       asp-action="Announcements">
                        Announcements
                    </a>

                    <a asp-controller="Home"
                       asp-action="Privacy">
                        Privacy
                    </a>
                </div>

                <div class="echo-footer-column">
                    <h3>Get Involved</h3>

                    <div class="echo-footer-column">
                        <h3>Get Involved</h3>

                        <a asp-controller="Home"
                           asp-action="Join">
                            Join ECHO
                        </a>

                        <a asp-controller="Home"
                           asp-action="Auditions">
                            Auditions
                        </a>

                        <a asp-controller="Home"
                           asp-action="Support">
                            Support ECHO
                        </a>
                    </div>
                </div>

                <div class="echo-footer-column">
                    <h3>Our Declaration</h3>

                    <p class="echo-footer-declaration">
                        His Voice.<br />
                        Transform a Generation.
                    </p>
                </div>
            </div>

            <div class="echo-footer-bottom">
                <p>
                    &copy; @DateTime.Now.Year ECHO Creative Arts Ministry.
                    All rights reserved.
                </p>

                <p>
                    Established 2026
                </p>
            </div>
        </div>
    </footer>

    <button type="button"
            class="echo-scroll-top"
            id="echoScrollTop"
            aria-label="Scroll back to the top of the page">

        <span aria-hidden="true">↑</span>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>